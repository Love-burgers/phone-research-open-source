# Chat-completions endpoint. Users can enter their own key on the homepage
# (tab memory only), or configure this local environment for persistent use.
# Leave empty to use source-only reports until a key is entered.
MODEL_API_KEY=
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=40
MODEL_MAX_TOKENS=1800
# Optional: deepseek or openai-compatible. Empty means infer from endpoint.
MODEL_PROVIDER=

# Chat uses the bundled real-phone corpus, separate from the research index.
# Empty means runs/chat-sessions.sqlite3 under the working directory.
CHAT_STORAGE_PATH=
# Home chat uses model-directed tools by default. 0 keeps the fixed retrieval path.
CHAT_AGENT_ENABLED=1
# Per-turn conservative execution budget, separate from the provider context
# window and daily quota. Tool/model request counts remain bounded separately.
CHAT_CONTEXT_CHARACTERS=64000
CHAT_TURN_TOKEN_BUDGET=64000
# Up to 12 recent turns; structured requirements persist separately in SQLite.
CHAT_HISTORY_MESSAGES=24
CHAT_HISTORY_CHARACTERS=12000
# Remote listening requires a token. Use a long random value; the homepage
# accepts it in the access-key field and keeps it only in this tab's session.
CHAT_ACCESS_TOKEN=
# Persistent limits shared by workers; day resets at 00:00 UTC+8. 0 disables
# a particular limit. Unknown provider usage retains its conservative reserve.
CHAT_GUARD_PATH=
CHAT_RATE_LIMIT_PER_MINUTE=6
CHAT_DAILY_TURN_LIMIT=100
CHAT_DAILY_MODEL_CALLS=200
CHAT_DAILY_TOKEN_LIMIT=600000
# Optional real-phone index for chat. Empty keeps the bundled BM25 corpus.
CHAT_KNOWLEDGE_INDEX_PATH=
# bm25, vector, hybrid (RRF); empty follows the index type.
CHAT_RETRIEVAL_METHOD=
# Optional local semantic retrieval (install with pip install -e ".[local]").
# Prepare the model cache explicitly first; the running service never downloads it.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_LOCAL_CACHE_DIR=runs/model-cache
# CHAT_VECTOR_MIN_SCORE=0.35

# Separate embedding service, required only for --method vector.
# A chat model endpoint/key is not automatically an embedding service.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_LOCAL_CACHE_DIR=

FETCH_TIMEOUT_SECONDS=12
MAX_PAGE_BYTES=1500000
MAX_PAGE_CHARACTERS=120000
MAX_REDIRECTS=3

